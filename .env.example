# Copy to `.env` (read by both Next.js and the Prisma CLI; never committed).
# In production, set the same variables in the hosting provider's dashboard.

# PostgreSQL. With Neon, `neon env pull` (or `neon deploy`) writes both values:
# - DATABASE_URL: pooled (-pooler host), used by the app
# - DATABASE_URL_UNPOOLED: direct, used by Prisma migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Admin login (single account)
ADMIN_EMAIL="you@example.com"
# Generate with: npm run admin:hash
ADMIN_PASSWORD_HASH=""

# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=""
